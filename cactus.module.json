{
  "name": "product-attributes-for-shop",
  "version": "0.1.64",
  "tablePrefix": "pat_",
  "description": "Filterable product attributes for the shop: define attributes like Material or Colour, put a set of them on each product, set a value per variant, hide any from the public filters, show any on the product page's Specification tab in sections of your own, and let shoppers narrow the catalogue by the rest.",
  "requiresCoreVersion": "0.5.1026",
  "requiresModules": [
    {
      "name": "shop",
      "minVersion": "0.1.245"
    }
  ],
  "permissions": [],
  "settingsTabs": [
    {
      "id": "product-attributes-for-shop",
      "label": "Product attributes",
      "permission": "shop.manage",
      "host": "shop.settings-sub-tabs",
      "import": "./components/SettingsTab",
      "component": "ProductAttributesSettingsTab"
    }
  ],
  "requiredEnvVars": [],
  "cookieCategories": [],
  "extensionPoints": [
    {
      "point": "shop.products-tabs",
      "id": "product-attributes-for-shop",
      "label": "Attributes",
      "order": 25,
      "permission": "shop.products",
      "import": "./components/admin/AttributesTab",
      "component": "AttributesTab"
    },
    {
      "point": "shop.product-editor-sections",
      "id": "product-attributes-inline",
      "label": "Attributes",
      "order": 55,
      "permission": "shop.products",
      "import": "./components/admin/ProductAttributesSection",
      "component": "ProductAttributesSection"
    },
    {
      "point": "shop-variations.variant-field-provider",
      "id": "product-attributes",
      "permission": "shop.products",
      "import": "./lib/variant-field-provider",
      "component": "productAttributesVariantFieldProvider"
    },
    {
      "point": "shop.product-field-provider",
      "id": "product-attributes",
      "permission": "shop.products",
      "import": "./lib/product-field-provider",
      "component": "productAttributesProductFieldProvider"
    },
    {
      "point": "core.media-reference-rewriters",
      "id": "product-attributes-for-shop",
      "import": "./lib/media-reference-rewriter",
      "component": "productAttributesMediaReferenceRewriter"
    },
    {
      "point": "shop-variations.option-source",
      "id": "product-attributes",
      "permission": "shop.products",
      "import": "./lib/option-source-provider",
      "component": "productAttributesOptionSourceProvider"
    },
    {
      "point": "core.media-usage-providers",
      "id": "product-attributes-for-shop",
      "import": "./lib/media-usage-provider",
      "component": "productAttributesMediaUsageProvider"
    },
    {
      "point": "shop.product-detail-spec",
      "id": "product-attributes-spec",
      "import": "./lib/detail-spec-provider",
      "component": "productAttributesSpecProvider"
    }
  ],
  "puckBlocks": [
    {
      "type": "ShopAttributeFilterGrid",
      "import": "./components/puck/ShopAttributeFilterGrid",
      "component": "shopAttributeFilterGridPuckComponent",
      "rscComponent": "shopAttributeFilterGridPuckRscComponent",
      "rscImport": "./components/puck/ShopAttributeFilterGrid.rsc",
      "layoutTypes": [
        "shopIndex",
        "shopCategory",
        "shopCollection",
        "shopTag"
      ]
    }
  ],
  "memberExtensions": {
    "activityTypes": [],
    "notificationCategories": [],
    "routeTiers": []
  },
  "teardown": [
    "pat_variation_attach_blocks",
    "pat_product_attributes",
    "pat_product_values",
    "pat_product_spec_sections",
    "pat_attribute_values",
    "pat_attributes",
    "pat_attribute_groups",
    "pat_settings"
  ]
}
